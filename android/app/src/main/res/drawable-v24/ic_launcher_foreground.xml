<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Stadium Ring Halo Glow -->
    <path
        android:pathData="M54,16 A38,38 0 1,1 53.9,16 Z"
        android:strokeWidth="1.5"
        android:strokeColor="#335865F2"
        android:fillColor="#00000000" />

    <!-- Arena Crest Hexagonal Shield Background -->
    <path
        android:pathData="M54,20 L82,34 L82,72 L54,88 L26,72 L26,34 Z"
        android:strokeWidth="2.5"
        android:strokeColor="#5865F2">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="26"
                android:startY="20"
                android:endX="82"
                android:endY="88"
                android:type="linear">
                <item android:offset="0.0" android:color="#2B2D31" />
                <item android:offset="1.0" android:color="#18191C" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Golden Champion Star on Top Crest -->
    <path
        android:pathData="M54,24 L55.5,27.5 L59,28 L56.5,30.5 L57,34 L54,32 L51,34 L51.5,30.5 L49,28 L52.5,27.5 Z"
        android:fillColor="#FACC15" />

    <!-- Futuristic 'A' Monogram for ATLAS ARENA -->
    <path
        android:pathData="M54,36 L70,76 L62,76 L58,66 L50,66 L46,76 L38,76 Z M54,48 L51.5,60 L56.5,60 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="38"
                android:startY="36"
                android:endX="70"
                android:endY="76"
                android:type="linear">
                <item android:offset="0.0" android:color="#00F5D4" />
                <item android:offset="0.5" android:color="#5865F2" />
                <item android:offset="1.0" android:color="#7289DA" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Crossbar Energy Flare -->
    <path
        android:pathData="M48,63 L60,63"
        android:strokeWidth="1.5"
        android:strokeColor="#00F5D4" />

</vector>
